#!/bin/sh
set -e

[ "$1" = configure ] || exit 0

if [ -e /usr/share/debconf/confmodule ]; then
  . /usr/share/debconf/confmodule

  OPTS="--config config.json"

  db_get pisugar-server/model
  if [ -z "$RET" ]; then
    db_set pisugar-server/model "PiSugar 3"
    RET="PiSugar 3"
  fi
  OPTS="$OPTS --model '$RET'"

  db_get pisugar-server/address
  ADDR="$RET"

  db_get pisugar-server/web
  if test "x$RET" = "xtrue"; then
    OPTS="$OPTS --web /usr/share/pisugar-server/web --http $ADDR:8421 --ws $ADDR:8422 "
  fi

  db_get pisugar-server/tcp
  if test "x$RET" = "xtrue"; then
    OPTS="$OPTS --tcp $ADDR:8423"
  fi

  db_get pisugar-server/uds
  if test "x$RET" = "xtrue"; then
    OPTS="$OPTS --uds /tmp/pisugar-server.sock"
  fi

  echo "OPTS=$OPTS" >/etc/default/pisugar-server

  if which jq > /dev/null; then
    echo "Configuring authentication settings"

    db_get pisugar-server/auth-username
    username="$RET"
    db_get pisugar-server/auth-password
    password="$RET"

    if test "x$username" != "x" && test "x$password" != "x"; then
      # Write beside the original so rename is atomic. Never truncate on jq errors.
      config_file=/etc/pisugar-server/config.json
      tmp_config=$(mktemp "${config_file}.XXXXXX")
      trap 'rm -f "$tmp_config"' EXIT HUP INT TERM
      chmod --reference="$config_file" "$tmp_config"
      chown --reference="$config_file" "$tmp_config"
      jq --arg u "$username" --arg p "$password" \
        '.auth_user=$u | .auth_password=$p' "$config_file" > "$tmp_config"
      mv -f "$tmp_config" "$config_file"
      trap - EXIT HUP INT TERM
      db_set pisugar-server/auth-password ""
    else
      echo "Skipping authentication setup as username or password is empty"
    fi
  else
    echo "jq is unavailable; preserving existing authentication settings"
  fi
  echo "PiSugar server configured. Visit http://[host_ip]:8421; use dpkg-reconfigure pisugar-server to configure authentication."

fi

# Enable i2c
if which raspi-config > /dev/null 2>&1; then
  echo "Found raspi-config, enabling I2C interface"
  raspi-config nonint do_i2c 0 || true
fi

deb-systemd-helper unmask pisugar-server.service >/dev/null || true
if deb-systemd-helper --quiet was-enabled pisugar-server.service; then
  deb-systemd-helper enable pisugar-server.service >/dev/null || true
  deb-systemd-invoke start pisugar-server.service || true
else
  deb-systemd-helper update-state pisugar-server.service >/dev/null || true
fi
